
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "cemantudlasan2@gmail.com";
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isNotBlocked() {
        return !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) || isAdmin();

      match /dailyPostComments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && !exists(/databases/$(database)/documents/users/$(userId)/personalBlockList/$(request.auth.uid));
        allow update: if request.auth != null && request.auth.uid == resource.data.authorId;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.authorId || isOwner(userId) || isAdmin());
      }

      match /personalBlockList/{blockedUserId} {
        allow read, write: if isOwner(userId);
      }

      match /students/{studentId} {
        allow read, write: if isOwner(userId);
        match /attendance/{attendanceId} {
          allow read, write: if isOwner(userId);
        }
        match /reminders/{reminderId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /students-record/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow create: if request.auth != null;
        allow read, update, delete: if isOwner(userId);
      }

      match /memorandums/{memoId} {
        allow read, write: if isOwner(userId);
      }

      match /flashcards/{flashcardId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /user_pets/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /blockedUsers/{userId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
    }

    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if request.auth != null && isNotBlocked();
      allow update: if request.auth != null && isNotBlocked();
      allow delete: if (request.auth != null && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.userId || isAdmin();
      
      match /applications/{applicationId} {
        allow create: if request.auth.uid == request.resource.data.applicantId;
        allow read: if get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid || isAdmin();
        allow delete: if get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid || isAdmin();
        allow update: if false;
      }
    }

    match /quotes/{quoteId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /movies/{movieId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /analytics/{eventId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read: if true;
    }
  }
}
